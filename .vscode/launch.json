{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "qemu-gdb-arm",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/loader/kernel.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "linux": {
                "miDebuggerPath": "gdb-multiarch"
            },
            "osx": {
                "miDebuggerPath": "gdb"
            },
            "miDebuggerServerAddress": "localhost:1234",
            "stopAtEntry": false,
            "setupCommands": [
                {"text": "-enable-pretty-printing"}
            ],
            "postRemoteConnectCommands": [
                {"text": "hbreak start_aarch64"}
            ],
            "launchCompleteCommand": "exec-continue",
            "preLaunchTask": "qemu-gdb-arm"
        },
        
        {
            "name": "qemu-gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/loader/kernel.elf",
            "cwd": "${workspaceFolder}",
            "miDebuggerPath": "rust-gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "stopAtEntry": false,
            "setupCommands": [
                {"text": "-enable-pretty-printing"},
                {"text": "set disassembly-flavor intel"},
                {"text": "add-symbol-file ${workspaceRoot}/loader/initrd/bin/hello"}
            ],
            "preLaunchTask": "qemu-gdb"
        }
    ]
}
